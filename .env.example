# Copy to .env. Generate independent random values before starting the stack.
# PowerShell: [Convert]::ToHexString([Security.Cryptography.RandomNumberGenerator]::GetBytes(32))
POSTGRES_PASSWORD=replace-with-random-secret
SERVICE_TOKEN=replace-with-random-secret
N8N_ENCRYPTION_KEY=replace-with-64-hex-characters
SIM_WORDPRESS_USER=demo
SIM_WORDPRESS_PASSWORD=replace-with-random-secret
SIM_CONTROL_TOKEN=replace-with-random-secret
DEMO_REFERENCE_DATE=2026-09-28
MODE=demo
DEMO_PASSWORD=DemoStudio!2026
MODEL_PROVIDER=fixture
TRANSCRIPTION_PROVIDER=fixture
TRANSCRIPTION_MODEL=whisper-1
COOKIE_SECURE=false

# Optional connected AI adapter: leave empty for deterministic fixture mode.
OPENAI_API_KEY=
MODEL_ID=

# The following are for scripts/n8n/bootstrap.py after creating an n8n owner
# and credentials in the local n8n UI. N8N_API_KEY also lets the API read
# workflow publication status; it needs workflow:list scope at runtime.
# Never put the populated .env file in version control.
N8N_PUBLIC_URL=http://localhost:5678
N8N_HOST_PORT=5678
API_HOST_PORT=8000
SIM_HOST_PORT=8081
# DEMO replay needs "all" so n8n exposes success executions. In CONNECTED use "none".
N8N_SAVE_SUCCESS_EXECUTIONS=all
N8N_EXECUTION_MAX_AGE_HOURS=24
N8N_EXECUTION_MAX_COUNT=1000
API_BASE_URL=http://api:8000
WORDPRESS_BASE_URL=http://connector-sim:8081
N8N_HOST=localhost
N8N_PROTOCOL=http
N8N_WEBHOOK_URL=http://localhost:5678/
N8N_SECURE_COOKIE=false
N8N_API_KEY=
N8N_SERVICE_CREDENTIAL_ID=
N8N_WORDPRESS_CREDENTIAL_ID=
