{
  "id": "contentstudio_due_items_v1",
  "name": "ContentStudio / Process due editorial actions",
  "nodes": [
    {
      "id": "488dd452-aa57-59b0-ac6d-0725607b9c34",
      "name": "Scheduled work",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        0,
        -20
      ],
      "parameters": {
        "content": "## Recoverable polling\nApproved render/package/dispatch work is queried from Postgres. This avoids one Wait node per approval. Only explicit demo activation publishes this schedule.",
        "height": 180,
        "width": 600
      }
    },
    {
      "id": "ac3b462a-5169-50be-9bed-e851158ac24f",
      "name": "Check due items",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.3,
      "position": [
        40,
        220
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 5
            }
          ]
        }
      }
    },
    {
      "id": "4b281340-6f78-5c02-acdf-8f6a24f520da",
      "name": "Replay due fixture",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2.1,
      "position": [
        40,
        430
      ],
      "parameters": {
        "httpMethod": "POST",
        "path": "contentstudio/due-demo",
        "authentication": "headerAuth",
        "responseMode": "onReceived",
        "options": {
          "noResponseBody": true,
          "responseCode": {
            "values": {
              "responseCode": "customCode",
              "customCode": 202
            }
          }
        }
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "__SERVICE_CREDENTIAL_ID__",
          "name": "ContentStudio service token"
        }
      },
      "webhookId": "b7977290-1a3e-53e3-a81f-5f4dd7d477b1"
    },
    {
      "id": "e80976d9-2255-584e-abbe-c8880cb53ed6",
      "name": "List workspaces",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        320,
        220
      ],
      "parameters": {
        "url": "__API_BASE_URL__/internal/workflows/workspaces",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "timeout": 120000,
          "redirect": {
            "redirect": {
              "followRedirects": false
            }
          }
        }
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "__SERVICE_CREDENTIAL_ID__",
          "name": "ContentStudio service token"
        }
      }
    },
    {
      "id": "32bf2c4a-7b21-574d-8236-aca6f23650ef",
      "name": "Expand workspaces",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        600,
        220
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "return ($input.first().json.items || []).map((workspace, i) => ({json: {workspace_id: workspace.id}, pairedItem: {item: 0}}));"
      }
    },
    {
      "id": "f501b505-ab7a-50cf-880e-9f3dd1149b31",
      "name": "Find due actions",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        880,
        220
      ],
      "parameters": {
        "url": "__API_BASE_URL__/internal/workflows/due",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "timeout": 120000,
          "redirect": {
            "redirect": {
              "followRedirects": false
            }
          }
        },
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "workspace_id",
              "value": "={{ $json.workspace_id }}"
            }
          ]
        }
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "__SERVICE_CREDENTIAL_ID__",
          "name": "ContentStudio service token"
        }
      }
    },
    {
      "id": "82e6b3d5-100d-5ac5-91a4-0438c760b802",
      "name": "Expand due actions",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1160,
        220
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "return $input.all().flatMap((row, i) => (row.json.items || []).map(item => ({json: item, pairedItem: {item: i}})));"
      }
    },
